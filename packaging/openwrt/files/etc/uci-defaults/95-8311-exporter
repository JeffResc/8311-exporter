#!/bin/sh
# Run once after IPK install.
# The 8311 firmware's /etc/config/firewall whitelists 22/80/443/319:320 on
# the LAN zone and ends with `Default-Block-LAN` (REJECT). fw3 applies rules
# in file order using `-A` (append), so our Allow rule must sit BEFORE the
# block, not after it, or it never fires.

# Add the rule (idempotently).
if [ "$(uci -q get firewall.8311_exporter)" != "rule" ]; then
	uci -q batch <<EOF
set firewall.8311_exporter=rule
set firewall.8311_exporter.name='Allow-8311-exporter'
set firewall.8311_exporter.src='lan'
set firewall.8311_exporter.proto='tcp'
set firewall.8311_exporter.dest_port='9833'
set firewall.8311_exporter.target='ACCEPT'
EOF
fi

# Reorder so we sit immediately before Default-Block-LAN. Idempotent: if the
# block rule isn't present (custom firewall configs) we leave ordering alone.
block_idx=$(uci show firewall 2>/dev/null | \
	awk -F'[][]' "/\\.name='Default-Block-LAN'/ {print \$2; exit}")
[ -n "$block_idx" ] && uci -q reorder firewall.8311_exporter="$block_idx"

uci commit firewall
/etc/init.d/firewall reload >/dev/null 2>&1 || true
exit 0
