#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

NAME=8311-exporter
PROG=/usr/sbin/8311-exporter
PORT=9833

start_service() {
	config_load "$NAME"

	local enabled listen ethtool
	config_get_bool enabled main enabled 1
	config_get listen main listen "mgmt"
	config_get_bool ethtool main ethtool 1

	[ "$enabled" = "1" ] || return 1

	# Resolve 'mgmt' (the safe default) to the LCT management interface IP.
	# The 8311 firmware always exposes the host-facing management network
	# as the `lct` uci interface (eth0_0_1_lct, 192.168.98.1 by default).
	# Falling back to localhost keeps the service from accidentally binding
	# to all interfaces — including the PON-side bridges that face the
	# public network.
	case "$listen" in
		mgmt|"")
			local ip
			ip=$(uci -q get network.lct.ipaddr)
			listen="${ip:-127.0.0.1}:$PORT"
			;;
	esac

	procd_open_instance "$NAME"
	procd_set_param command "$PROG" -listen "$listen" \
		-ethtool="$([ "$ethtool" = "1" ] && echo true || echo false)"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/"$NAME"
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "$NAME"
}
